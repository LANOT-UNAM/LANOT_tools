# afai.cpt
# Alternate Floating Algae Index (VIIRS M-bands, sargazo)
# UNIT = AFAI
# COLOR_MODEL = RGB
#
# Rampa turbo entre -0.1 y 0.5, el rango con el que se hicieron las pruebas en
# QGIS sobre el Caribe mexicano. Agua limpia vive cerca de 0 y las balsas de
# sargazo se despegan hacia el verde-amarillo; arriba de 0.5 (nubes residuales,
# glint no enmascarado) satura en el rojo oscuro de F.
#
# N y B en negro: el mar sin dato (nube, tierra, glint) queda del mismo color
# que el fondo, como en las vistas de referencia. Para dejarlo transparente,
# usar -a / --alpha en lugar de -b.
#
# Un tramo por entrada util del LUT de 256 que arma ColorPaletteTable (256 - N
# - F = 253), de modo que la rampa se reproduce sin error de interpolacion.
# Equivale al SLD que exporta QGIS con turbo en este mismo rango.
