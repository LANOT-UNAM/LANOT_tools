%     FullDiskMap(at=(10, 4.5), scale=1, grid=false)  % solo tierra/costa
%     FullDiskMap(..., ocean="lightblue", land="tan")   % otros colores
%
% GENERADO, no editar a mano. Regenerar con (tools/geo2mg.py, requiere geopandas + datos Natural Earth 110m):
%   python3 hazmapa_mg.py --lat 0.0 --lon -75.0 --fill --tolerance 0.0 --min-feature 0.05 --grid-paso 30.0 --color-ocean steelblue --color-tierra #e6d3a3 --salida /home/aguilars/proyectos/mg/Metagrafica/lib/fulldisk_map.mg
