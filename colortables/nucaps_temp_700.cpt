# nucaps_temp_700.cpt
# NUCAPS Temperature @ 707 mb (700 hPa)
# Perfil de temperatura NUCAPS (CSPP HEAP), sondeos CrIS+ATMS.
# Los colores son los de sst.cpt, para que las vistas de temperatura de LANOT
# se lean igual; lo que cambia entre niveles es el rango, que es lo unico que
# no se puede compartir: 500 hPa vive 30 K por debajo de 850.
# Rango fijo y no percentiles: asi dos pasadas del mismo nivel se comparan.
# UNIT = K
# COLOR_MODEL = RGB
# Value R G B   Value R G B
